{
  "manifest_version": 3,
  "name": "Instagram Live Scanner",
  "version": "2.0.0",
  "description": "When enabled, collects Instagram profiles you encounter while scrolling in Safari and sends them to your Render library.",
  "permissions": ["storage", "tabs", "alarms"],
  "host_permissions": [
    "https://www.instagram.com/*",
    "https://*.onrender.com/*",
    "http://localhost/*",
    "http://127.0.0.1/*"
  ],
  "background": {"service_worker": "background.js"},
  "content_scripts": [
    {"matches":["https://www.instagram.com/*"],"js":["content.js"],"run_at":"document_idle"}
  ],
  "action": {"default_popup":"popup.html", "default_title":"IG Live Scanner"}
}
